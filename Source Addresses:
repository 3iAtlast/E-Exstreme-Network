private boolean check(TreeNode node, long lo, long hi) {
    if (node == null) return true;
    if (node.val <= lo || node.val >= hi) return false;
    return check(node.left, lo, node.val)
        && check(node.right, node.val, hi);
}public List<String> paths(TreeNode root) {
    List<String> out = new ArrayList<>();
    walk(root, "", out);
    return out;
}

private void walk(TreeNode n, String path, List<String> out) {
    if (n == null) return;
    path += n.val;
    if (n.left == null && n.right == null) out.add(path);
    else {
        walk(n.left, path + "->", out);
        walk(n.right, path + "->", out);
    }
