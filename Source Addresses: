import math

def rhombus(alpha_deg, a=1.0, I=1.0):
    al = math.radians(alpha_deg)
    p = 2 * a * math.sin(al / 2)          # short diagonal
    q = 2 * a * math.cos(al / 2)          # long diagonal
    area_sin = a**2 * math.sin(al)        # a² sin α
    area_diag = p * q / 2                 # pq/2 (cross-check)
    s = math.sin(al)
    return {
        "unit_circle": (math.cos(al), s),                 # point (cos α, sin α)
        "perimeter": 4 * a,
        "diagonals": (p, q),
        "area": area_sin,
        "areas_agree": math.isclose(area_sin, area_diag, abs_tol=1e-12),
        "inradius": p * q / (2 * math.sqrt(p**2 + q**2)), # = a·sin α / 2
        "moment": I * area_sin,                           # m = I·A
        "cot": "undefined" if abs(s) < 1e-12 else math.cos(al) / s,
    }

